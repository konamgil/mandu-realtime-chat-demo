{
  "name": "mandu-chat-demo",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.9",
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "routes:generate": "./node_modules/.bin/mandu routes generate",
    "dev": "PORT=3333 ./node_modules/.bin/mandu dev",
    "dev:safe": "./node_modules/.bin/mandu lock && PORT=3333 ./node_modules/.bin/mandu dev --watch",
    "build": "./node_modules/.bin/mandu build",
    "start": "./node_modules/.bin/mandu start",
    "check": "./node_modules/.bin/mandu check",
    "guard": "./node_modules/.bin/mandu guard",
    "lock": "./node_modules/.bin/mandu lock", 
    "test": "bun test tests/*.test.ts",
    "test:unit": "bun test tests/*.test.ts",
    "test:e2e": "bunx playwright test",
    "record:setup": "bunx playwright install chromium",
    "record:demo": "bun run scripts/record-realtime-chat.ts",
    "test:ate:e2e": "bun run scripts/run-ate-e2e.ts"
  },
  "dependencies": {
    "@mandujs/core": "file:../mandu/packages/core",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@mandujs/ate": "file:../mandu/packages/ate",
    "@mandujs/cli": "file:../mandu/packages/cli",
    "@playwright/test": "^1.58.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "playwright": "^1.58.2",
    "typescript": "^5.0.0"
  },
  "overrides": {}
}
